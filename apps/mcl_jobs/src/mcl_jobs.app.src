{application, mcl_jobs, [
    {description, "LinkedIn as it was intended, but over the Macula Mesh"},
    {vsn, "0.1.0"},
    {registered, [mcl_jobs_sup]},
    {mod, {mcl_jobs_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Mesh SDK, realm identity, capabilities, health.
        mcl_om,
        %% This service's own event store (mcl_jobs_app opens it).
        reckon_db,
        evoq,
        reckon_evoq,
        %% The CMD divisions. Library applications: their desks run inside
        %% evoq's aggregate processes, against the store mcl_jobs_app opens.
        guide_profile_lifecycle,
        guide_organisation_lifecycle
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-jobs"}]}
]}.
