%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_jobs.
%%
%% LinkedIn as it was intended, but over the Macula Mesh
%%
%% Generated by `rebar3 new mcl_service'. The scaffold boots, joins the mesh
%% and answers /health; it does nothing else yet.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) transitively, and no persistence: since 0.35.0
    %% mcl_om starts no reckon-db or evoq application. The floor is the mcl_om
    %% this scaffold came from.
    %% 1.6: macula 18, where a handler-bearing capability must name who may
    %% call it and a subscription who may deliver to it -- both refused at boot
    %% (macula#147). This service declares no subscription at all, and writes
    %% its caller decision down in capabilities/0.
    {mcl_om, "~> 1.6"},
    %% Declared directly: this service calls macula modules of its own (and
    %% compiles against its behaviours), rather than reaching the mesh only
    %% through mcl_om. Naming the major is what stops a rebuild from taking the
    %% next one silently (macula-codebase-checks#14). 18 keeps wire 1.0; over
    %% 16 it brings the two caller rules above and carries 16's revocation
    %% bound, which changes nothing here -- this service gates no overlay and
    %% issues no endorsement.
    {macula, "~> 18.0"},

    %% THIS SERVICE'S OWN EVENT STORE, opened by mcl_jobs_app before mcl_om:boot/1.
    %% Our libraries float at ~> MAJOR.MINOR (dev rule, 2026-09-30): a build takes
    %% the newest release, e.g. reckon_evoq 2.7.2+ (reads snapshots back whole)
    %% and evoq 1.26.1+ (telemetry durations on the monotonic clock).
    {reckon_db,   "~> 5.4"},
    {evoq,        "~> 1.26"},
    {reckon_evoq, "~> 2.7"},

    %% The read model project_jobs writes and query_jobs answers from: one
    %% SQLite file beside the event store. esqlite builds its bundled SQLite
    %% from source, so the builder image needs nothing more.
    {esqlite,     "~> 0.9"}
]}.

%% khepri 0.17 (via reckon_db) uses the deprecated `catch' expression, which
%% warnings_as_errors refuses on OTP 28+.
{overrides, [
    {override, khepri, [{erl_opts, [nowarn_deprecated_catch]}]}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}},
            {elvis_style, max_function_length, #{max_length => 60}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% A service's handlers implement `macula_response' and call `macula' directly,
%% but macula comes in only through mcl_om, so it is not in the PLT unless it is
%% named here: dialyzer would report every macula call as unknown.
{dialyzer, [{plt_extra_apps, [macula]}]}.

{relx, [
    {release, {mcl_jobs, "0.4.0"}, [mcl_jobs, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
